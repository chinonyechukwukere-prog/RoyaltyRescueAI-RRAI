# =============================================================================
# RRAI — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# Architecture v1.7 §11.3
# =============================================================================

# ---------------------------------------------------------------------------
# Supabase — Public (safe for browser bundles)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ---------------------------------------------------------------------------
# Supabase — Server-side secret (NEVER use NEXT_PUBLIC_ prefix)
# Used exclusively for system-context writes (citizen intake, safety controls,
# background jobs). Must never appear in client bundles or API responses.
# Architecture v1.7 §10.1a, §11.3, §12
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ---------------------------------------------------------------------------
# IBM watsonx.ai (OA-2 — confirm model ID and endpoint with Technical Lead)
# ---------------------------------------------------------------------------
WATSONX_API_KEY=your_ibm_cloud_iam_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ---------------------------------------------------------------------------
# Organization routing (Architecture v1.7 §7.5)
# DEFAULT_CITIZEN_ORG_ID: UUID of Org A (RapidResponse NG) — all citizen
# portal submissions are routed here. Set to the actual UUID after seeding.
# WEBHOOK_ORG_B_ID: UUID of Org B (Lagos 112) — set to actual UUID after seeding.
# ---------------------------------------------------------------------------
DEFAULT_CITIZEN_ORG_ID=aaaaaaaa-0001-0001-0001-000000000001
WEBHOOK_ORG_B_ID=bbbbbbbb-0002-0002-0002-000000000002

# ---------------------------------------------------------------------------
# Mock 112 Webhook (F11 — conditional feature)
# ---------------------------------------------------------------------------
WEBHOOK_112_SECRET=replace_with_a_random_secret_string

# ---------------------------------------------------------------------------
# Hospital availability configuration
# ---------------------------------------------------------------------------
OUTDATED_THRESHOLD_HOURS=4

# ---------------------------------------------------------------------------
# API base URL (optional — leave empty in development to use local Next.js routes)
# In production with a separate backend, set to the full backend URL.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=
